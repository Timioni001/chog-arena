# Local dev: copy to .env.local. Cloudflare: public values go in .env.production.local (build time),
# server values become Worker secrets (`npx wrangler secret put NAME`). See docs/DEPLOY.md.

# ---------- public (baked into the client at build time) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Monad mainnet RPC used by the browser. Use a provider key in production; the public RPC is rate-limited.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
# Verified Chog Genesis (ERC-721) and $CHOG (ERC-20) on Monad. See docs/collection-research.md.
NEXT_PUBLIC_CHOG_NFT_ADDRESS=0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763
NEXT_PUBLIC_CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777
# Optional: enables WalletConnect (QR + mobile deep links). Get one at cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Fill after deploying contracts/ (leave empty to hide onchain shop and match recording).
NEXT_PUBLIC_SEASONS_ADDRESS=
NEXT_PUBLIC_SHOP_ADDRESS=

# ---------- server only ----------
MONAD_RPC_URL=https://rpc.monad.xyz
# Signs SIWE sessions and challenge links. Required in production: `openssl rand -hex 32`.
SESSION_SECRET=
# Key that signs EIP-712 match results; its address must equal ChogArenaSeasons.attestor.
# Use a dedicated hot key with no funds.
ATTESTOR_PRIVATE_KEY=
# Persistent store (leaderboards, MMR, clans, cloud saves). Required on Cloudflare; without it an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
